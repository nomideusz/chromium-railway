#!/bin/sh
# Unauthenticated /healthcheck for Railway that answers 200 only while the
# Selkies streaming backend is up: it proxies to Selkies (200 on current
# builds, 426 "upgrade required" on older ones; 502 when it's down). A static
# 200 here would keep a dead desktop looking healthy.
# init-nginx regenerates the live config from /defaults/default.conf and turns
# on basic auth when PASSWORD is set, so patch every copy: init order is moot
# (Ubuntu bases use sites-available, Arch/Fedora conf.d, Alpine http.d).
# awk, not sed: Alpine's busybox sed lacks GNU's `0,/re/` first-match address.
PORT="${CUSTOM_WS_PORT:-8082}"
for F in /defaults/default.conf /etc/nginx/sites-available/default /etc/nginx/conf.d/default.conf /etc/nginx/http.d/default.conf; do
  [ -f "$F" ] || continue
  grep -q '/healthcheck' "$F" && continue
  awk -v port="$PORT" '!done && /^  location / {
    print "  location = /healthcheck {"
    print "    auth_basic off;"
    print "    proxy_pass http://127.0.0.1:" port "/;"
    print "    proxy_http_version 1.1;"
    print "    proxy_intercept_errors on;"
    print "    error_page 426 = @selkies_up;"
    print "  }"
    print "  location @selkies_up { auth_basic off; return 200 \"ok\"; }"
    done = 1
  } { print }' "$F" > "$F.tmp" && cat "$F.tmp" > "$F" && rm -f "$F.tmp"
done
