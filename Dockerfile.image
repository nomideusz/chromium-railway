# Actions builds this file from the image branch. The Dockerfile on main is one FROM line over the
# result, so deployers get Railway's update notice without a full build on Railway.
FROM linuxserver/chromium:f1bb645d-ls62

# Debian's security update reaches apt before LinuxServer's weekly rebuild does, so take it here.
# The exact version also stops the build cache from reusing an older apt layer.
ARG CHROMIUM_VERSION=156.0.8078.79-1~deb13u1
RUN apt-get update && apt-get install -y --only-upgrade "chromium=$CHROMIUM_VERSION" "chromium-common=$CHROMIUM_VERSION" && rm -rf /var/lib/apt/lists/*

# Upstream starts Xvfb with a 15360x8640 screen, which pins ~600 MB for the
# framebuffer alone and OOM-kills the desktop on Railway's 512 MB Trial plan.
# 4K is plenty; Selkies still resizes the desktop to the browser window.
ENV MAX_RES=3840x2160

# ponytail: one custom-init script adds an unauthenticated /healthcheck
# location for Railway's healthcheck prober; everything else is stock.
COPY root/ /
RUN chmod +x /custom-cont-init.d/20-healthcheck
